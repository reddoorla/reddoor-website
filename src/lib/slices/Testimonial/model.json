{
  "id": "testimonial",
  "type": "SharedSlice",
  "name": "Testimonial",
  "description": "Testimonial",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Pull quote on the paper band + avatar/name/role credit",
      "imageUrl": "",
      "primary": {
        "label": {
          "type": "Text",
          "config": {
            "label": "label",
            "placeholder": "e.g. What clients are saying:"
          }
        },
        "quote": {
          "type": "Text",
          "config": {
            "label": "quote",
            "placeholder": "Quote text WITHOUT the “ ” marks — the design draws them"
          }
        },
        "name": {
          "type": "Text",
          "config": {
            "label": "name",
            "placeholder": "e.g. Albert Turgon"
          }
        },
        "role": {
          "type": "Text",
          "config": {
            "label": "role",
            "placeholder": "e.g. COO of MSOT (Medical Solutions of Texas)"
          }
        },
        "avatar": {
          "type": "Image",
          "config": {
            "label": "avatar",
            "constraint": {
              "width": 400,
              "height": 400
            },
            "thumbnails": []
          }
        },
        "isAnimated": {
          "type": "Boolean",
          "config": {
            "label": "isAnimated",
            "placeholder_false": "static",
            "placeholder_true": "animated",
            "default_value": true
          }
        },
        "hide": {
          "type": "Boolean",
          "config": {
            "label": "hide",
            "placeholder_false": "visible",
            "placeholder_true": "hidden",
            "default_value": false
          }
        }
      },
      "items": {}
    }
  ]
}

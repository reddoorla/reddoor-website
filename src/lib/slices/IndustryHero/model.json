{
  "id": "industry_hero",
  "type": "SharedSlice",
  "name": "IndustryHero",
  "description": "IndustryHero",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Full-bleed photo hero: Besley headline bottom-left, intro column bottom-right",
      "imageUrl": "",
      "primary": {
        "image": {
          "type": "Image",
          "config": {
            "label": "image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "headline": {
          "type": "StructuredText",
          "config": {
            "label": "headline",
            "placeholder": "e.g. We'll Take Your MedTech Brand from Screened Out to Short List",
            "allowTargetBlank": true,
            "single": "heading1"
          }
        },
        "card_label": {
          "type": "Text",
          "config": {
            "label": "card_label",
            "placeholder": "e.g. Brand-Credibility Framework"
          }
        },
        "card_body": {
          "type": "StructuredText",
          "config": {
            "label": "card_body",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "buttons",
            "fields": {
              "link": {
                "type": "Link",
                "config": {
                  "label": "link",
                  "placeholder": "e.g. Get Started",
                  "allowTargetBlank": true,
                  "allowText": true,
                  "select": null
                }
              }
            }
          }
        },
        "isAnimated": {
          "type": "Boolean",
          "config": {
            "label": "isAnimated",
            "placeholder_false": "static",
            "placeholder_true": "animated",
            "default_value": true
          }
        },
        "hide": {
          "type": "Boolean",
          "config": {
            "label": "hide",
            "placeholder_false": "visible",
            "placeholder_true": "hidden",
            "default_value": false
          }
        }
      },
      "items": {}
    }
  ]

{
  "id": "logo_grid",
  "type": "SharedSlice",
  "name": "LogoGrid",
  "description": "LogoGrid",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Rail label + CTA beside a static client-logo grid on the paper band",
      "imageUrl": "",
      "primary": {
        "label": {
          "type": "Text",
          "config": {
            "label": "label",
            "placeholder": "e.g. Clients: Join these brands in building trust"
          }
        },
        "link": {
          "type": "Link",
          "config": {
            "label": "link",
            "placeholder": "e.g. Our Work → /portfolio",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "logos": {
          "type": "Group",
          "config": {
            "label": "logos",
            "repeat": true,
            "fields": {
              "logo": {
                "type": "Image",
                "config": {
                  "label": "logo",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "name": {
                "type": "Text",
                "config": {
                  "label": "name",
                  "placeholder": "brand name — used as the logo's alt text"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "link",
                  "placeholder": "optional — links this logo to its project",
                  "select": null,
                  "allowTargetBlank": true,
                  "allowText": false,
                  "repeat": false
                }
              }
            }
          }
        },
        "hasTopPadding": {
          "type": "Boolean",
          "config": {
            "label": "hasTopPadding",
            "placeholder_false": "no top padding",
            "placeholder_true": "top padding",
            "default_value": true
          }
        },
        "hasBottomPadding": {
          "type": "Boolean",
          "config": {
            "label": "hasBottomPadding",
            "placeholder_false": "no bottom padding",
            "placeholder_true": "bottom padding",
            "default_value": true
          }
        },
        "isAnimated": {
          "type": "Boolean",
          "config": {
            "label": "isAnimated",
            "placeholder_false": "static",
            "placeholder_true": "animated",
            "default_value": true
          }
        },
        "hide": {
          "type": "Boolean",
          "config": {
            "label": "hide",
            "placeholder_false": "visible",
            "placeholder_true": "hidden",
            "default_value": false
          }
        }
      },
      "items": {}
    }
  ]
}

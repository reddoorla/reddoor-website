{
  "name": "reddoor-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.11.0"
  },
  "scripts": {
    "dev": "vite dev --host",
    "vite:dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . --plugin prettier-plugin-svelte . && eslint .",
    "format": "prettier --write . --plugin prettier-plugin-svelte .",
    "prepare": "simple-git-hooks",
    "test": "pnpm test:unit && pnpm test:smoke",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:smoke": "playwright install chromium && playwright test --grep @smoke",
    "test:nightly": "playwright test --grep @nightly",
    "test:scaffold": "playwright test --grep-invert @smoke",
    "test:e2e": "playwright test",
    "vite:devHost": "vite dev --host --port 8888",
    "prismic:gen": "prismic gen types && prismic gen slice-index"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.65.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@zerodevx/svelte-img": "^2.1.2",
    "eslint": "^10.5.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prismic": "^1.21.0",
    "sharp": "^0.35.0",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-svelte-plugin": "^0.3.52",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@lucide/svelte": "^1.20.0",
    "@prismicio/client": "^7.21.8",
    "@prismicio/svelte": "^2.2.1",
    "@reddoorla/maintenance": "^0.104.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "fuse.js": "^7.4.2",
    "satori": "^0.35.0",
    "svelte-gestures": "^5.2.2"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -x node_modules/.bin/lint-staged ]; then node_modules/.bin/lint-staged; else echo \"pre-commit: node_modules is not installed in this checkout, so prettier did not run\"; fi"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}

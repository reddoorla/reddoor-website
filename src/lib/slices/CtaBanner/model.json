{
  "id": "cta_banner",
  "type": "SharedSlice",
  "name": "CtaBanner",
  "description": "CtaBanner",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Full-bleed band with a large question headline and one CTA button",
      "imageUrl": "",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "heading",
            "placeholder": "e.g. Are you ready for your brand to go from being overlooked?",
            "allowTargetBlank": true,
            "single": "heading2"
          }
        },
        "buttonLabel": {
          "type": "Text",
          "config": {
            "label": "buttonLabel",
            "placeholder": "e.g. Talk with a founder"
          }
        },
        "buttonLink": {
          "type": "Link",
          "config": {
            "label": "buttonLink",
            "placeholder": "",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "background": {
          "type": "Select",
          "config": {
            "label": "background",
            "options": ["white", "gray", "red", "paper", "paper-red"],
            "default_value": "paper-red"
          }
        },
        "hasTopPadding": {
          "type": "Boolean",
          "config": {
            "label": "hasTopPadding",
            "placeholder_false": "no top padding",
            "placeholder_true": "top padding",
            "default_value": true
          }
        },
        "hasBottomPadding": {
          "type": "Boolean",
          "config": {
            "label": "hasBottomPadding",
            "placeholder_false": "no bottom padding",
            "placeholder_true": "bottom padding",
            "default_value": true
          }
        },
        "isAnimated": {
          "type": "Boolean",
          "config": {
            "label": "isAnimated",
            "placeholder_false": "static",
            "placeholder_true": "animated",
            "default_value": true
          }
        },
        "hide": {
          "type": "Boolean",
          "config": {
            "label": "hide",
            "placeholder_false": "visible",
            "placeholder_true": "hidden",
            "default_value": false
          }
        }
      },
      "items": {}
    }
  ]
}
